      "expectedRuntimeValueChanges": [
        {
          "id": "closed-world-precision-axis-meet",
          "kind": "selection-outcome-changing",
          "surface": "query closed-world reachability precision",
          "reason": "Open-world, non-enumerated, and missing-member reachability results now remain heuristic because world-assumption participates in the meet; a sound sealed bundle can still raise the result to exact.",
          "evidence": [
            {
              "sourcePath": "rust/crates/omena-query/src/style/transform.rs",
              "needles": [
                "assert_eq!(open_world_precision, FactPrecision::Heuristic);",
                "assert_eq!(closed_world_precision, FactPrecision::Exact);",
                "\"loweringAxis\": \"worldAssumption\""
              ]
            }
          ]
        },
        {
          "id": "css-modules-export-usage-flow-precision",
          "kind": "selection-outcome-changing",
          "surface": "CSS Modules unused-export diagnostic precision",
          "reason": "An unused-export diagnostic backed by complete module resolution now reports conservative precision because source-selector usage flow participates in the meet instead of being discarded behind an exact value-domain label.",
          "evidence": [
            {
              "sourcePath": "rust/crates/omena-query/src/style/diagnostics/source_usage.rs",
              "needles": ["flow: FlowPrecisionV1::SourceSelectorUsage"]
            },
            {
              "sourcePath": "rust/crates/omena-query/src/style/diagnostics/tests/source_usage.rs",
              "needles": [
                "assert_eq!(report.diagnostics[0].precision, FactPrecision::Conservative);",
                "\"loweringAxis\": \"flow\""
              ]
            }
          ]
        }

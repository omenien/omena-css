{
  "schemaVersion": "1",
  "product": "omena-cascade.custom-property-fixed-point-witness-corpus",
  "oracle": {
    "statusOrder": "unresolvedBottomLeResolvedValue",
    "environmentOrder": "pointwise",
    "initialApproximation": "allBottom",
    "transfer": "simultaneousOriginalBindingEvaluation",
    "unresolvedAtFixedPoint": "guaranteedInvalid"
  },
  "cases": [
    {
      "id": "direct-literal",
      "cycleShape": null,
      "bindings": {
        "--tone": { "literal": "red" }
      },
      "expectedImplementation": {
        "--tone": { "literal": "red" }
      },
      "expectedEvaluator": {
        "--tone": { "literal": "red" }
      },
      "expectedImplementationIterations": 1,
      "expectedEvaluatorIterations": 2,
      "expectedImplementationReachedFixedPoint": true,
      "expectedDisposition": "agreement"
    },
    {
      "id": "acyclic-alias-chain",
      "cycleShape": null,
      "bindings": {
        "--a-alias": { "var": { "name": "--z-base", "fallback": null } },
        "--z-base": { "literal": "red" }
      },
      "expectedImplementation": {
        "--a-alias": { "literal": "red" },
        "--z-base": { "literal": "red" }
      },
      "expectedEvaluator": {
        "--a-alias": { "literal": "red" },
        "--z-base": { "literal": "red" }
      },
      "expectedImplementationIterations": 2,
      "expectedEvaluatorIterations": 3,
      "expectedImplementationReachedFixedPoint": true,
      "expectedDisposition": "agreement"
    },
    {
      "id": "missing-reference-fallback",
      "cycleShape": null,
      "bindings": {
        "--tone": {
          "var": {
            "name": "--missing",
            "fallback": { "literal": "blue" }
          }
        }
      },
      "expectedImplementation": {
        "--tone": { "literal": "blue" }
      },
      "expectedEvaluator": {
        "--tone": { "literal": "blue" }
      },
      "expectedImplementationIterations": 1,
      "expectedEvaluatorIterations": 2,
      "expectedImplementationReachedFixedPoint": true,
      "expectedDisposition": "agreement"
    },
    {
      "id": "plain-two-cycle",
      "cycleShape": "mutualReferenceWithoutFallback",
      "bindings": {
        "--a": { "var": { "name": "--b", "fallback": null } },
        "--b": { "var": { "name": "--a", "fallback": null } }
      },
      "expectedImplementation": {
        "--a": "guaranteedInvalid",
        "--b": "guaranteedInvalid"
      },
      "expectedEvaluator": {
        "--a": "guaranteedInvalid",
        "--b": "guaranteedInvalid"
      },
      "expectedImplementationIterations": 1,
      "expectedEvaluatorIterations": 1,
      "expectedImplementationReachedFixedPoint": true,
      "expectedDisposition": "agreement"
    },
    {
      "id": "mutually-recursive-fallback-chain",
      "cycleShape": "mutuallyRecursiveFallbackChain",
      "bindings": {
        "--a": {
          "var": {
            "name": "--b",
            "fallback": { "literal": "red" }
          }
        },
        "--b": {
          "var": {
            "name": "--a",
            "fallback": { "literal": "blue" }
          }
        }
      },
      "expectedImplementation": {
        "--a": "guaranteedInvalid",
        "--b": "guaranteedInvalid"
      },
      "expectedEvaluator": {
        "--a": "guaranteedInvalid",
        "--b": "guaranteedInvalid"
      },
      "expectedImplementationIterations": 1,
      "expectedEvaluatorIterations": 1,
      "expectedImplementationReachedFixedPoint": true,
      "expectedDisposition": "agreement"
    },
    {
      "id": "cycle-through-fallback",
      "cycleShape": "cycleThroughFallback",
      "bindings": {
        "--a": {
          "var": {
            "name": "--missing",
            "fallback": { "var": { "name": "--b", "fallback": null } }
          }
        },
        "--b": {
          "var": {
            "name": "--a",
            "fallback": { "literal": "green" }
          }
        }
      },
      "expectedImplementation": {
        "--a": "guaranteedInvalid",
        "--b": "guaranteedInvalid"
      },
      "expectedEvaluator": {
        "--a": "guaranteedInvalid",
        "--b": "guaranteedInvalid"
      },
      "expectedImplementationIterations": 1,
      "expectedEvaluatorIterations": 1,
      "expectedImplementationReachedFixedPoint": true,
      "expectedDisposition": "agreement"
    },
    {
      "id": "three-node-fallback-cycle-entered-mid-chain",
      "cycleShape": "threeNodeFallbackCycleEnteredMidChain",
      "bindings": {
        "--entry": { "var": { "name": "--cycle-b", "fallback": null } },
        "--cycle-a": {
          "var": {
            "name": "--cycle-b",
            "fallback": { "literal": "red" }
          }
        },
        "--cycle-b": {
          "var": {
            "name": "--cycle-c",
            "fallback": { "literal": "green" }
          }
        },
        "--cycle-c": {
          "var": {
            "name": "--cycle-a",
            "fallback": { "literal": "blue" }
          }
        }
      },
      "expectedImplementation": {
        "--cycle-a": "guaranteedInvalid",
        "--cycle-b": "guaranteedInvalid",
        "--cycle-c": "guaranteedInvalid",
        "--entry": "guaranteedInvalid"
      },
      "expectedEvaluator": {
        "--cycle-a": "guaranteedInvalid",
        "--cycle-b": "guaranteedInvalid",
        "--cycle-c": "guaranteedInvalid",
        "--entry": "guaranteedInvalid"
      },
      "expectedImplementationIterations": 2,
      "expectedEvaluatorIterations": 1,
      "expectedImplementationReachedFixedPoint": true,
      "expectedDisposition": "agreement"
    }
  ]
}

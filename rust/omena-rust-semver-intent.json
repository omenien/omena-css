          "surface": "DesignTokenRankedReferenceV0.winnerDeclarationLayerRank",
          "reason": "The serialized value moves to the unlayered-normal sentinel while preserving every ordering comparison.",
          "evidence": [
            {
              "sourcePath": "rust/crates/omena-semantic/src/design_tokens.rs",
              "needles": [
                "Opaque cascade ordering token; consumers must not interpret it as a layer-count magnitude.",
                "return normalized_layer_rank(false, None);"
              ]
            },
            {
              "sourcePath": "rust/crates/omena-semantic/src/tests.rs",
              "needles": [
                "fn ranks_unlayered_design_tokens_above_later_layered_tokens()",
                "assert_eq!(ranked_reference.winner_declaration_layer_rank, i32::MAX);"
              ]
            },
            {
              "sourcePath": "rust/crates/omena-query/src/types.rs",
              "needles": [
                "Opaque cascade ordering token; consumers must not interpret it as a layer-count magnitude."
              ]
            }
          ]
        },
        {
          "id": "design-token-unresolved-selector-fallback",
          "kind": "selection-outcome-changing",
          "surface": "CascadeLayerContextV0::layer_rank_for",
          "reason": "An unresolved selector in a layered context now falls back to the unlayered-normal sentinel instead of the weakest layered rank.",

            {
              "sourcePath": "rust/crates/omena-semantic/src/design_tokens.rs",
              "needles": [
                "normalized_layer_rank(false, selector_rank.and_then(LayerOrdinal::new))",
                "fn unresolved_layer_selector_uses_the_unlayered_normal_ordering_token()"
              ]
            }
          ]
        }
      ]

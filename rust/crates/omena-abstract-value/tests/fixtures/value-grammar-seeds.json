      "id": "width-round-known-divergence",
      "property": "width",
      "value": "round(up, 101px, 10px)",
      "adjudication": "omenaMatcherDefect",
      "reason": "round() remains an explicitly unvalidated standard math-function class and is never promoted to a definite computed-value rejection",
      "owner": "value-grammar-function-matching",
      "specUrl": "https://drafts.csswg.org/css-values-4/#round-func"
    },

{
  "name": "@omena/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:wasm": "wasm-pack build ../../rust/crates/omena-wasm --target web --out-dir ../../../apps/docs/public/wasm --out-name omena_wasm",
    "check": "pnpm run typecheck && pnpm run build",
    "dev": "vite dev",
    "postbuild": "node scripts/prepare-static-output.mjs",
    "preview": "vite preview",
    "start": "serve .output/public",
    "typecheck": "fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/start-static-server-functions": "1.167.32",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.4",
    "lucide-react": "^1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "nitro": "3.0.260610-beta",
    "serve": "^14.2.6",
    "srvx": "^0.12.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
